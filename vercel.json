{
  "cleanUrls": true,
  "functions": {
    "api/places.js": {
      "maxDuration": 25
    }
  },
  "rewrites": [
    { "source": "/icons/plate-180.png", "destination": "/api/touch-icon?s=180" },
    { "source": "/icons/plate-192.png", "destination": "/api/touch-icon?s=192" },
    { "source": "/icons/plate-512.png", "destination": "/api/touch-icon?s=512" },
    { "source": "/apple-touch-icon.png", "destination": "/api/touch-icon?s=180" },
    { "source": "/apple-touch-icon-precomposed.png", "destination": "/api/touch-icon?s=180" },
    { "source": "/apple-touch-icon-180x180.png", "destination": "/api/touch-icon?s=180" },
    { "source": "/apple-touch-icon-180x180-precomposed.png", "destination": "/api/touch-icon?s=180" },
    { "source": "/icons/icon-180.png", "destination": "/api/touch-icon?s=180" },
    { "source": "/icons/icon-192.png", "destination": "/api/touch-icon?s=192" },
    { "source": "/icons/icon-512.png", "destination": "/api/touch-icon?s=512" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/places",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=14400, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}