{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/places",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=14400, stale-while-revalidate=86400" }
      ]
    }
  ]
}
